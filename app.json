{
  "expo": {
    "name": "menba",
    "slug": "menba",
    "scheme": "menba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFA"
    },
    "ios": {
      "bundleIdentifier": "com.menba.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.menba.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F5C52"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c02c9255-8658-403b-b4d7-b1bfd612b1ca"
      }
    }
  }
}
