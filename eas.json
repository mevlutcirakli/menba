{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "node": "22.19.0",
            "environment": "development"
        },
        "preview": {
            "distribution": "internal",
            "node": "22.19.0",
            "environment": "preview",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            }
        },
        "production": {
            "autoIncrement": true,
            "node": "22.19.0",
            "environment": "production"
        }
    },
    "submit": {
        "production": {}
    }
}